# Postgres (наша аналитическая БД)
# Значения ниже — для запуска с хоста (py -m etl.run).
# Airflow внутри docker-сети получает свои из docker-compose.yml
POSTGRES_DB=dota_analytics
POSTGRES_USER=dota_user
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# pgAdmin (localhost:5050)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=

# OpenDota
# account_id игрока, чьи матчи тянем
ACCOUNT_ID=
# опционально, поднимает лимиты OpenDota API
OPENDOTA_API_KEY=

# Служебная БД Airflow (наружу не пробрасывается)
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=

# Вход в веб-интерфейс Airflow (localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# Ключ шифрования сохранённых подключений Airflow.
# Сгенерировать: py -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Если оставить пустым, Airflow сгенерирует свой при каждом старте
AIRFLOW_FERNET_KEY=

# Ключ подписи сессий веб-интерфейса (любая случайная строка)
AIRFLOW_SECRET_KEY=

# Только для Linux/WSL: id пользователя, от которого Airflow пишет файлы (id -u).
# На Windows и macOS оставить пустым
AIRFLOW_UID=